<Application x:Class="GamingTweaker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Remplacé au démarrage par ThemeApplication (sombre ou clair, selon Windows ou le choix de l'utilisateur) -->
                <ResourceDictionary Source="Ui/Couleurs.Sombre.xaml"/>
                <ResourceDictionary Source="Ui/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
