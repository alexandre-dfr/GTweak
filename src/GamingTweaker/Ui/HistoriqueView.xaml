<UserControl x:Class="GamingTweaker.Ui.HistoriqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Racine">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="SectionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="SessionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="12,8" Margin="0,0,0,2" CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource PanelHoverBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource PanelHoverBrush}"/><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SessionTemplate">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DebutTexte}" FontWeight="SemiBold"/>
                    <Border x:Name="badge" Style="{StaticResource Badge}" Background="{StaticResource SurBg}" Margin="10,0,0,0">
                        <TextBlock x:Name="badgeText" Text="{Binding EtatLibelle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SurFg}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Resume}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Anormale}" Value="True">
                    <Setter TargetName="badge" Property="Background" Value="{StaticResource RisqueBg}"/>
                    <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource RisqueFg}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="OptionSessionTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Titre}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap">
                        <Run Text="{Binding Statut, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Message, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="Annuler" Command="{Binding AnnulerCommand}" Padding="10,4" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Annulable}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="QuarantaineTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Nom}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TailleTexte, StringFormat=' · {0}'}" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Origine}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Restaurer" Padding="10,4" CommandParameter="{Binding}" Command="{Binding DataContext.RestaurerQuarantaineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Supprimer définitivement" Padding="10,4" Margin="8,0,0,0" CommandParameter="{Binding}" Command="{Binding DataContext.PurgerQuarantaineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,0,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Désinstaller GamingTweaker…" Command="{Binding DesinstallerCommand}" Margin="16,0,0,0"
                    ToolTip="Retire la routine planifiée et le dossier de données (sessions, journaux d'annulation, quarantaine) après un aperçu et une confirmation. Les réglages appliqués ne sont pas annulés : utilisez d'abord « Tout restaurer »."/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Sessions" Style="{StaticResource SectionButton}" Command="{Binding ChoisirSectionCommand}" CommandParameter="Sessions"/>
                <Button Content="Quarantaine" Style="{StaticResource SectionButton}" Command="{Binding ChoisirSectionCommand}" CommandParameter="Quarantaine"/>
                <Button Content="Mesures" Style="{StaticResource SectionButton}" Command="{Binding ChoisirSectionCommand}" CommandParameter="Mesures"/>
                <Button Content="Actualiser" Command="{Binding ActualiserCommand}" Margin="16,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Sessions -->
        <Grid Grid.Row="1" Visibility="{Binding EstSessions, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="8">
                <Grid>
                    <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SessionSelectionnee, Mode=TwoWay}" ItemTemplate="{StaticResource SessionTemplate}"
                             ItemContainerStyle="{StaticResource SessionItemStyle}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    <TextBlock Text="Aucune session pour l'instant." Foreground="{StaticResource MutedBrush}" Margin="8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Sessions.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="170"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Annuler toute la session" CommandParameter="{Binding SessionSelectionnee}" Command="{Binding AnnulerSessionCommand}"/>
                        <TextBlock Text="Options de la session" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SessionSelectionnee.Options}" ItemTemplate="{StaticResource OptionSessionTemplate}"/>
                    </ScrollViewer>
                    <TextBox Grid.Row="2" Text="{Binding RapportTexte, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Quarantaine -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14,10" Visibility="{Binding EstQuarantaine, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Fichiers retirés par le nettoyage, conservés jusqu'à leur suppression définitive." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Quarantaine}" ItemTemplate="{StaticResource QuarantaineTemplate}"/></ScrollViewer>
                    <TextBlock Text="La quarantaine est vide." Foreground="{StaticResource MutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Quarantaine.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Mesures -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14,10" Visibility="{Binding EstMesures, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource WarnBg}" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                    <TextBlock Text="{Binding AvertissementInputLag}" TextWrapping="Wrap" Foreground="{StaticResource AvanceFg}"/>
                </Border>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Relever (30 s)" Style="{StaticResource PrimaryButton}" Command="{Binding ReleverCommand}"/>
                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Progression, Mode=OneWay}" Height="8" Margin="12,0" VerticalAlignment="Center"
                                 Visibility="{Binding EnReleve, Converter={StaticResource BoolVis}}"/>
                    <Button Grid.Column="2" Content="Comparer les deux cochés" Command="{Binding ComparerCommand}"/>
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Releves}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3">
                                    <TextBlock Text="{Binding Libelle}" TextWrapping="Wrap"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBox Grid.Row="3" Text="{Binding Comparaison, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="110" FontFamily="Consolas" FontSize="12"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
