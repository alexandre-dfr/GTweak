<Window x:Class="GamingTweaker.Ui.PlanifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="Routine hebdomadaire"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="Routine hebdomadaire" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource PoliceTitre}"/>
        <TextBlock x:Name="Explication" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,16"/>
        <Border Style="{StaticResource CarteW11}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Chaque" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Width="130" AutomationProperties.Name="Jour de la semaine" ItemsSource="{Binding Jours}" SelectedValuePath="Jour" SelectedValue="{Binding Jour, Mode=TwoWay}" ToolTip="Jour de la semaine">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Nom}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="à" VerticalAlignment="Center" Margin="10,0"/>
                    <TextBox Width="84" AutomationProperties.Name="Heure, au format 20:00" Text="{Binding Heure, UpdateSourceTrigger=PropertyChanged}" ToolTip="Heure, au format 20:00"/>
                </StackPanel>
                <TextBlock Text="{Binding EtatTexte}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <DockPanel Margin="0,20,0,0">
            <Button DockPanel.Dock="Left" Content="Supprimer la routine" Command="{Binding SupprimerCommand}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Fermer" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="Planifier" Style="{StaticResource PrimaryButton}" Command="{Binding PlanifierCommand}" ToolTip="Applique chaque semaine le profil sélectionné, sans interface"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
