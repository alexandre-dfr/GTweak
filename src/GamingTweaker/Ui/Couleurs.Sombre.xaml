<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Couleurs du thème sombre (Windows 11). Les vues les lisent en DynamicResource : le thème change sans redémarrer. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="BgBrush" Color="#202020"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#323232"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3B3B3B"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="DiscretBrush" Color="#9E9E9E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5AB9E8"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#363636"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#292929"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="SurBg" Color="#1F3A26"/>
    <SolidColorBrush x:Key="SurFg" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="AvanceBg" Color="#433519"/>
    <SolidColorBrush x:Key="AvanceFg" Color="#FCE100"/>
    <SolidColorBrush x:Key="RisqueBg" Color="#442726"/>
    <SolidColorBrush x:Key="RisqueFg" Color="#FF99A4"/>
    <SolidColorBrush x:Key="WarnBg" Color="#433519"/>
</ResourceDictionary>
