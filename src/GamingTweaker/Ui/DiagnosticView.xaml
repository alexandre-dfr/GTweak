<UserControl x:Class="GamingTweaker.Ui.DiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="0,0,16,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="Relancer l'analyse" Command="{Binding AnalyserCommand}"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Resume}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="Ce qui bride réellement les performances en jeu. Rien n'est modifié : chaque point propose la page des Paramètres ou l'option qui le corrige."
                           Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Points}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="pastille" Width="10" Height="10" CornerRadius="5" Background="{DynamicResource SurFg}" VerticalAlignment="Top" Margin="0,6,14,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Titre}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="detail" Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="action" Grid.Column="2" Content="{Binding ActionTexte}" Margin="16,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding DataContext.ActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Niveau}" Value="Attention"><Setter TargetName="pastille" Property="Background" Value="{DynamicResource AvanceFg}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Niveau}" Value="Info"><Setter TargetName="pastille" Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Action}" Value="{x:Null}"><Setter TargetName="action" Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding Detail}" Value=""><Setter TargetName="detail" Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
