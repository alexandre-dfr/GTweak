<Window x:Class="GamingTweaker.Ui.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GamingTweaker.Ui"
        Style="{StaticResource AppWindow}"
        Title="Assistant après installation de Windows" Width="900" Height="680" MinWidth="760" MinHeight="520"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <local:InverseBoolVersVisibilite x:Key="InverseBoolVis"/>

        <!-- Élément d'une liste (application, mise à jour, application à retirer…) -->
        <DataTemplate x:Key="ElementTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Titre}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Titre}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Border x:Name="badge" Style="{StaticResource Badge}" Background="{DynamicResource SurBg}" Margin="10,0,0,0">
                            <TextBlock x:Name="badgeText" Text="{Binding Risque}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SurFg}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </CheckBox>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Risque}" Value="Avancé">
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource AvanceBg}"/>
                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource AvanceFg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Risque}" Value="Risqué">
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource RisqueBg}"/>
                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource RisqueFg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Absent}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Contenu d'une liste chargée : message, « Tout », éléments -->
        <DataTemplate x:Key="ListeTemplate">
            <StackPanel>
                <TextBlock Text="Chargement de la liste…" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding EnChargement, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding Erreur}" Foreground="{DynamicResource RisqueFg}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers><DataTrigger Binding="{Binding Erreur}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Visibility="{Binding Charge, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <CheckBox Content="Tout (y compris les éléments apparus plus tard)" IsChecked="{Binding Tous, Mode=TwoWay}" FontWeight="SemiBold" Margin="0,0,0,6"
                              Visibility="{Binding SupporteTous, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="Rien à proposer sur ce PC." Foreground="{DynamicResource MutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Elements.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Elements}" ItemTemplate="{StaticResource ElementTemplate}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Option d'un menu ; si elle a une liste et qu'elle est cochée, ses éléments s'affichent dessous -->
        <DataTemplate x:Key="OptionTemplate">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                <StackPanel>
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Titre}" AutomationProperties.HelpText="{Binding Description}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Titre}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Border x:Name="badge" Style="{StaticResource Badge}" Background="{DynamicResource SurBg}" Margin="10,0,0,0">
                                    <TextBlock x:Name="badgeText" Text="{Binding Risque}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SurFg}"/>
                                </Border>
                                <TextBlock Text="{Binding Etat}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>
                    <ContentControl x:Name="liste" Content="{Binding Liste}" ContentTemplate="{StaticResource ListeTemplate}" Margin="26,8,0,0" Visibility="Collapsed" Focusable="False"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Risque}" Value="Avancé">
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource AvanceBg}"/>
                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource AvanceFg}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ALaListe}" Value="True"/>
                        <Condition Binding="{Binding IsChecked}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="liste" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Étapes : la courante est en évidence ; un clic y va directement -->
        <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <ListBox x:Name="ListeEtapes" ItemsSource="{Binding Etapes}" SelectedIndex="{Binding Index, Mode=OneWay}" SelectionChanged="Etape_SelectionChanged"
                     Background="Transparent" BorderThickness="0" Margin="0,16,0,0" AutomationProperties.Name="Étapes de l'assistant"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Court}" FontSize="14" Margin="10,5" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Column="1" Margin="28,22,24,20">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Text="{Binding Courante.Numero}" Foreground="{DynamicResource MutedBrush}" FontSize="13"/>
                <TextBlock Text="{Binding Courante.Question}" FontSize="24" FontWeight="SemiBold" FontFamily="{StaticResource PoliceTitre}" TextWrapping="Wrap" Margin="0,4,0,8"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="{Binding Courante.Explication}" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Recommandé" Command="{Binding RecommanderCommand}" Margin="0,0,8,0"
                        Visibility="{Binding Courante.EstOptions, Converter={StaticResource BoolVis}}" ToolTip="Coche les options Sûr de cette question"/>
                <Button DockPanel.Dock="Left" Content="Rien" Command="{Binding RienCommand}" ToolTip="Ne rien faire à cette étape"
                        Visibility="{Binding Courante.EstRecap, Converter={StaticResource InverseBoolVis}}"/>
                <Button x:Name="BoutonApercu" DockPanel.Dock="Right" Content="Voir l'aperçu" Style="{StaticResource PrimaryButton}" Click="Apercu_Click" Margin="8,0,0,0"
                        IsEnabled="{Binding AUneSelection}" Visibility="{Binding EstDerniere, Converter={StaticResource BoolVis}}"/>
                <Button DockPanel.Dock="Right" Content="Suivant" Style="{StaticResource PrimaryButton}" Command="{Binding SuivantCommand}" Margin="8,0,0,0" IsDefault="True"
                        Visibility="{Binding EstDerniere, Converter={StaticResource InverseBoolVis}}"/>
                <Button DockPanel.Dock="Right" Content="Précédent" Command="{Binding PrecedentCommand}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Fermer" IsCancel="True" ToolTip="Fermer l'assistant : les cases cochées restent cochées dans la fenêtre principale"/>
            </DockPanel>

            <ScrollViewer x:Name="Defilement" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <!-- Menu d'options -->
                    <ItemsControl ItemsSource="{Binding Courante.Options}" ItemTemplate="{StaticResource OptionTemplate}"
                                  Visibility="{Binding Courante.EstOptions, Converter={StaticResource BoolVis}}"/>
                    <!-- Applications d'une option du menu Installation -->
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10"
                            Visibility="{Binding Courante.EstApplis, Converter={StaticResource BoolVis}}">
                        <ContentControl Content="{Binding Courante.OptionApplis.Liste}" ContentTemplate="{StaticResource ListeTemplate}" Focusable="False"/>
                    </Border>
                    <!-- Récapitulatif -->
                    <ItemsControl ItemsSource="{Binding Recap}" Visibility="{Binding Courante.EstRecap, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Etape}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="choix" Grid.Column="1" Text="{Binding Choix}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Vide}" Value="True">
                                        <Setter TargetName="choix" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
