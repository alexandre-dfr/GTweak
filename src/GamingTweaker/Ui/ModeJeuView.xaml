<UserControl x:Class="GamingTweaker.Ui.ModeJeuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GamingTweaker.Ui">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <local:NonNulVersVisibilite x:Key="NonNulVis"/>
        <DataTemplate x:Key="ChoixTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3">
                <StackPanel>
                    <TextBlock Text="{Binding Affichage}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </UserControl.Resources>
    <!-- Tout défile : listes de hauteur fixe, réglages sur leur propre ligne au-dessus des boutons. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,16,12">
        <StackPanel>
            <TextBlock Text="Libère des ressources le temps d'une session : les services et processus que vous cochez sont arrêtés, puis relancés avec « Rétablir ». Les processus système critiques, la sécurité, l'audio et les pilotes d'affichage ne sont jamais proposés."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
        </StackPanel>
        <Border Padding="14,10" CornerRadius="6" Background="{DynamicResource WarnBg}" Margin="0,0,0,10" Visibility="{Binding EstActif, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Le Mode Jeu est actif. Rétablissez-le pour redémarrer ce qui a été arrêté." TextWrapping="Wrap" Foreground="{DynamicResource AvanceFg}" FontWeight="SemiBold"/>
        </Border>
        <Grid IsEnabled="{Binding PeutModifier}" Height="240">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Services en cours d'exécution" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Services}" ItemTemplate="{StaticResource ChoixTemplate}"/></ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Processus de votre session" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Processus}" ItemTemplate="{StaticResource ChoixTemplate}"/></ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <StackPanel Margin="0,12,0,0">
            <!-- Réglages du Mode Jeu -->
            <WrapPanel Margin="0,0,0,10">
                    <CheckBox Content="Passer au plan Performances élevées" IsChecked="{Binding UtiliserPlan, Mode=TwoWay}" VerticalAlignment="Center" IsEnabled="{Binding PeutModifier}"/>
                    <CheckBox Content="Libérer la mémoire" IsChecked="{Binding LibererMemoire, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0" IsEnabled="{Binding PeutModifier}"
                              ToolTip="Récupère la mémoire inutilisée des programmes en arrière-plan (rien n'est fermé ; utile avec 8 ou 16 Go de RAM). Le jeu au premier plan et les jeux surveillés ne sont pas touchés."/>
                    <ComboBox Width="230" Height="32" Margin="16,0,0,0" ItemsSource="{Binding ProfilsNvidiaDisponibles}" SelectedValuePath="Key" DisplayMemberPath="Value"
                              SelectedValue="{Binding ProfilNvidia, Mode=TwoWay}" IsEnabled="{Binding PeutModifier}"
                              Visibility="{Binding NvidiaDisponible, Converter={StaticResource BoolVis}}"
                              ToolTip="Performance : performances maximales, filtrage hautes performances, V-Sync désactivée, faible latence Ultra. Qualité : performances maximales, filtrage haute qualité, V-Sync laissée au jeu. Les réglages d'avant sont remis en quittant le Mode Jeu."/>
            </WrapPanel>
            <!-- Actions -->
            <WrapPanel>
                    <Button Content="Activer le Mode Jeu" Style="{StaticResource PrimaryButton}" Command="{Binding ActiverCommand}"/>
                    <Button Content="Actualiser les listes" Command="{Binding ActualiserCommand}" Margin="8,0,0,0"/>
                    <Button Content="Rétablir" Command="{Binding RetablirCommand}" Margin="8,0,0,0"/>
                    <Button Content="Oublier l'état" Command="{Binding OublierCommand}" Margin="8,0,0,0" Visibility="{Binding PeutOublier, Converter={StaticResource BoolVis}}" ToolTip="Abandonner le rétablissement (après confirmation)"/>
            </WrapPanel>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
            <!-- Diagnostic NVIDIA : ce que le pilote contient réellement -->
            <DockPanel Margin="0,8,0,0" Visibility="{Binding NvidiaDisponible, Converter={StaticResource BoolVis}}">
                <Button DockPanel.Dock="Left" Content="Lire les réglages NVIDIA" Command="{Binding LireNvidiaCommand}" VerticalAlignment="Top"
                        ToolTip="Affiche les valeurs actuellement enregistrées dans le pilote (paramètres globaux)"/>
                <TextBlock Text="{Binding EtatNvidia}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="12,2,0,0"/>
            </DockPanel>
        </StackPanel>
        <!-- Mode Jeu automatique : liste des jeux, réglages repris de la sélection ci-dessus, démarrage avec Windows. -->
        <Border DataContext="{Binding Auto}" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="14,10" Margin="0,12,0,0"
                Visibility="{Binding DataContext.Auto, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NonNulVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Actif, Mode=TwoWay}" VerticalAlignment="Center">
                        <TextBlock Text="Mode Jeu automatique : s'active quand un jeu de la liste démarre, tout est rétabli quand vous quittez le dernier" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </CheckBox>
                    <CheckBox Grid.Column="1" Content="Démarrer avec Windows" IsChecked="{Binding DemarrageAvecWindows, Mode=TwoWay}" Margin="16,0,0,0" VerticalAlignment="Center"
                              ToolTip="GamingTweaker démarre réduit près de l'horloge, avec les droits administrateur, depuis une copie protégée dans Program Files"/>
                </Grid>
                <ListBox ItemsSource="{Binding Jeux}" SelectedItem="{Binding JeuSelectionne, Mode=TwoWay}" Height="110" Margin="0,8,0,0"
                         Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Nom}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Source, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Chemin, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Ajouter un .exe" Command="{Binding AjouterExeCommand}" Margin="0,0,8,4"/>
                    <Button Content="Depuis Steam" Command="{Binding AjouterSteamCommand}" Margin="0,0,8,4"/>
                    <Button Content="Depuis Epic Games" Command="{Binding AjouterEpicCommand}" Margin="0,0,8,4"/>
                    <Button Content="Retirer" Command="{Binding RetirerCommand}" Margin="0,0,8,4"/>
                    <Button Content="Utiliser la sélection ci-dessus" Command="{Binding ReprendreSelectionCommand}" Margin="0,0,8,4"
                            ToolTip="Le mode automatique arrête les services et processus cochés ci-dessus, et change le plan si la case est cochée"/>
                </WrapPanel>
                <CheckBox Content="Priorité haute pour le jeu en cours" IsChecked="{Binding PrioriteHaute, Mode=TwoWay}" Margin="0,6,0,0"
                          ToolTip="Le processus du jeu passe en priorité « Haute » (jamais « Temps réel ») : utile quand des programmes tournent en arrière-plan pendant la partie."/>
                <TextBlock Text="{Binding ResumeReglages}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
