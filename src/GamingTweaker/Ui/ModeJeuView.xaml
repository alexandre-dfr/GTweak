<UserControl x:Class="GamingTweaker.Ui.ModeJeuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <DataTemplate x:Key="ChoixTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3">
                <StackPanel>
                    <TextBlock Text="{Binding Affichage}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="0,0,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Libère des ressources le temps d'une session : les services et processus que vous cochez sont arrêtés, puis relancés avec « Rétablir ». Les processus système critiques, la sécurité, l'audio et les pilotes d'affichage ne sont jamais proposés."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
        </StackPanel>
        <Border Grid.Row="1" Padding="14,10" CornerRadius="6" Background="{StaticResource WarnBg}" Margin="0,0,0,10" Visibility="{Binding EstActif, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Le Mode Jeu est actif. Rétablissez-le pour redémarrer ce qui a été arrêté." TextWrapping="Wrap" Foreground="{StaticResource AvanceFg}" FontWeight="SemiBold"/>
        </Border>
        <Grid Grid.Row="2" IsEnabled="{Binding PeutModifier}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Services en cours d'exécution" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Services}" ItemTemplate="{StaticResource ChoixTemplate}"/></ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Processus de votre session" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Processus}" ItemTemplate="{StaticResource ChoixTemplate}"/></ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Content="Passer au plan Performances maximales" IsChecked="{Binding UtiliserPlan, Mode=TwoWay}" VerticalAlignment="Center" IsEnabled="{Binding PeutModifier}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Actualiser les listes" Command="{Binding ActualiserCommand}"/>
                    <Button Content="Activer le Mode Jeu" Style="{StaticResource PrimaryButton}" Command="{Binding ActiverCommand}" Margin="8,0,0,0"/>
                    <Button Content="Rétablir" Command="{Binding RetablirCommand}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
