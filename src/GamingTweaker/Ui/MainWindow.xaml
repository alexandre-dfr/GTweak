<Window x:Class="GamingTweaker.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GamingTweaker.Ui"
        Style="{StaticResource AppWindow}"
        Title="GamingTweaker" Width="1180" Height="720" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <DataTemplate x:Key="ListeElementTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3" HorizontalAlignment="Stretch">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Titre}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Border x:Name="badge" Style="{StaticResource Badge}" Background="{DynamicResource SurBg}" Margin="10,0,0,0">
                            <TextBlock x:Name="badgeText" Text="{Binding Risque}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SurFg}"/>
                        </Border>
                        <TextBlock x:Name="absent" Text="absent de ce PC" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource AvanceFg}" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </CheckBox>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Risque}" Value="Avancé">
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource AvanceBg}"/>
                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource AvanceFg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Risque}" Value="Risqué">
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource RisqueBg}"/>
                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource RisqueFg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Absent}" Value="True">
                    <Setter TargetName="absent" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="badge" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <CollectionViewSource x:Key="OptionsView" Source="{Binding Visibles}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Groupe"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="MenuItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="b" Margin="6,1" Padding="16,7" CornerRadius="4" Background="Transparent" Cursor="Hand">
                                <TextBlock x:Name="t" Text="{Binding Libelle}" FontSize="14" TextWrapping="Wrap"/>
                            </Border>
                            <Border x:Name="pastille" Width="3" Height="16" CornerRadius="1.5" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                            <Rectangle x:Name="sep" Height="1" Margin="18,8" Fill="{DynamicResource BorderBrush}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding EstSeparateur}" Value="True">
                                <Setter TargetName="b" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="sep" Property="Visibility" Value="Visible"/>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource NavHoverBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                <Setter TargetName="pastille" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="t" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="14,10" Margin="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource PanelBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Groupes repliés à l'ouverture d'un menu ; dépliés pendant une recherche (sinon les résultats seraient cachés). -->
        <Style x:Key="GroupExpander" TargetType="Expander">
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,6,0,2" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="arrow" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" VerticalAlignment="Center" Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </ToggleButton>
                            <ContentPresenter x:Name="content" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="content" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.EnRecherche, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="IsExpanded" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="OptionTemplate">
            <StackPanel>
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{Binding Titre}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border x:Name="badge" Style="{StaticResource Badge}" Background="{DynamicResource SurBg}">
                            <TextBlock x:Name="badgeText" Text="{Binding Risque}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SurFg}"/>
                        </Border>
                        <TextBlock Text="·" Margin="8,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="etat" Text="{Binding Etat}" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </CheckBox>
            <!-- Choix des éléments (options à liste) -->
            <StackPanel Margin="26,6,0,0" Visibility="{Binding ALaListe, Converter={StaticResource BoolVis}}">
                <Button Content="{Binding Liste.Resume}" Command="{Binding BasculerListeCommand}" HorizontalAlignment="Left" Cursor="Hand"
                        Padding="10,4" ToolTip="Afficher ou masquer la liste des éléments"/>
                <Border Margin="0,6,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource PanelHoverBrush}"
                        Visibility="{Binding ListeOuverte, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="Chargement…" Foreground="{DynamicResource MutedBrush}"
                                   Visibility="{Binding Liste.EnChargement, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding Liste.Erreur}" Foreground="{DynamicResource RisqueFg}" TextWrapping="Wrap" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers><DataTrigger Binding="{Binding Liste.Erreur}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Liste.ErreurDetail}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers><DataTrigger Binding="{Binding Liste.ErreurDetail}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Visibility="{Binding Liste.Charge, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding Liste.Message}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Style.Triggers><DataTrigger Binding="{Binding Liste.Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="Ouvrir la page officielle" Click="OuvrirLien_Click" Tag="{Binding Liste.Lien}" HorizontalAlignment="Left" Cursor="Hand" Padding="10,4" Margin="0,0,0,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers><DataTrigger Binding="{Binding Liste.Lien}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <CheckBox Content="Tout (y compris les éléments apparus plus tard)" IsChecked="{Binding Liste.Tous, Mode=TwoWay}" FontWeight="SemiBold" Margin="0,0,0,6"
                                      Visibility="{Binding Liste.SupporteTous, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="Aucun élément à proposer sur ce PC." Foreground="{DynamicResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Liste.Elements.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="ListeScroll_PreviewMouseWheel">
                                <ItemsControl ItemsSource="{Binding Liste.Elements}" ItemTemplate="{StaticResource ListeElementTemplate}"/>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Risque}" Value="Avancé">
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource AvanceBg}"/>
                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource AvanceFg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Risque}" Value="Risqué">
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource RisqueBg}"/>
                    <Setter TargetName="badgeText" Property="Foreground" Value="{DynamicResource RisqueFg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Etat}" Value="Déjà appliqué">
                    <Setter TargetName="etat" Property="Foreground" Value="{DynamicResource SurFg}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Avertissement d'élévation -->
        <StackPanel Grid.Row="0">
            <Border Background="{DynamicResource WarnBg}" Padding="20,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers><DataTrigger Binding="{Binding Bandeau}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Bandeau}" TextWrapping="Wrap" Foreground="{DynamicResource AvanceFg}"/>
            </Border>
            <!-- Nouvelle version publiée sur GitHub (rien n'est téléchargé : le bouton ouvre la page de la release) -->
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,8"
                    Visibility="{Binding NouvelleVersionVisible, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Click="MasquerNouvelleVersion_Click" Padding="8,2" Margin="8,0,0,0" ToolTip="Masquer jusqu'au prochain lancement"/>
                    <Button DockPanel.Dock="Right" Content="Voir la nouvelle version" Click="VoirNouvelleVersion_Click"/>
                    <TextBlock Text="{Binding TexteNouvelleVersion}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <!-- Mode Jeu laissé actif (arrêt brutal, redémarrage) -->
            <Border Background="{DynamicResource WarnBg}" Padding="20,8" Visibility="{Binding ModeJeu.EstActif, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Rétablir" Command="{Binding ModeJeu.RetablirCommand}"/>
                    <TextBlock Text="Mode Jeu encore actif : des services ou des processus sont toujours arrêtés." Foreground="{DynamicResource AvanceFg}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </StackPanel>
        <!-- Message d'information -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" Padding="20,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Click="FermerMessage_Click" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Top" ToolTip="Masquer ce message"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Background="{DynamicResource BgBrush}">
                <TextBlock DockPanel.Dock="Top" Text="GamingTweaker" FontFamily="{StaticResource PoliceTitre}" FontSize="15" FontWeight="SemiBold" Margin="22,14,16,6"/>
                <ListBox ItemsSource="{Binding Menus}" SelectedValuePath="Nom" SelectedValue="{Binding MenuCourant, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource MenuItemStyle}" Background="Transparent" BorderThickness="0" Padding="0,0,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>

            <Grid Grid.Column="1" Margin="28,22,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- En-tête : titre à gauche ; recherche et thème en haut à droite -->
                <Grid Margin="0,0,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TitreAffiche}" FontSize="28" FontWeight="SemiBold" FontFamily="{StaticResource PoliceTitre}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Grid Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBox x:Name="Recherche" Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,10,6" ToolTip="Rechercher une option dans tous les menus (Ctrl+F ; Échap pour effacer)"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource PoliceIcones}" FontSize="14" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="Rechercher une option" IsHitTestVisible="False" Margin="35,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Recherche}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <!-- Compteur en jeu (FPS, CPU, GPU, RAM) : un clic ouvre ses réglages ; icône en couleur d'accent quand il est affiché -->
                    <Button x:Name="BoutonCompteur" Grid.Column="2" Click="BoutonCompteur_Click" ToolTip="{Binding Compteur.EtatBouton}" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BoutonIcone}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Compteur.Actif}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource PoliceIcones}" FontSize="16"/>
                    </Button>
                    <!-- Thème : icône soleil / lune / palette ; un clic ouvre le choix -->
                    <Button x:Name="BoutonTheme" Grid.Column="3" Style="{StaticResource BoutonIcone}" Click="BoutonTheme_Click" ToolTip="Thème de l'application" VerticalAlignment="Center">
                        <TextBlock x:Name="IconeTheme" Text="&#xE790;" FontFamily="{StaticResource PoliceIcones}" FontSize="16"/>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MenuTheme" Placement="Bottom">
                                <MenuItem Header="Comme Windows" Tag="Systeme" Click="ChoixTheme_Click"><MenuItem.Icon><TextBlock Text="&#xE790;" FontFamily="{StaticResource PoliceIcones}" FontSize="14"/></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Clair" Tag="Clair" Click="ChoixTheme_Click"><MenuItem.Icon><TextBlock Text="&#xE706;" FontFamily="{StaticResource PoliceIcones}" FontSize="14"/></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Sombre" Tag="Sombre" Click="ChoixTheme_Click"><MenuItem.Icon><TextBlock Text="&#xE708;" FontFamily="{StaticResource PoliceIcones}" FontSize="14"/></MenuItem.Icon></MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- Bandeau des menus d'options : « Tout restaurer » (tous les menus) ; lien O&O ShutUp10++ sur Télémétrie seulement -->
                <Border Grid.Row="1" Margin="0,0,16,12" Padding="12,8" CornerRadius="8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding EstMenuOptions}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="Recommandé" Command="{Binding RecommanderCommand}" ToolTip="Coche les options sûres de ce menu"/>
                            <Button Content="Décocher" Command="{Binding DecocherCommand}" Margin="8,0,16,0" ToolTip="Décoche les options affichées"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Tout restaurer" Click="ToutRestaurer_Click" IsEnabled="{Binding PeutToutRestaurer}"
                                    ToolTip="Annule toutes les options appliquées par GamingTweaker, dans tous les menus : par le journal, sinon par un retour aux valeurs par défaut de Windows"/>
                            <Button Content="O&amp;O ShutUp10++ (site officiel)" Margin="8,0,0,0" Click="ShutUp_Click" ToolTip="Ouvre la page officielle d'O&amp;O ShutUp10++ dans le navigateur">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding EstMenuTelemetrie}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <CheckBox Content="Masquer les options déjà appliquées" IsChecked="{Binding MasquerAppliquees, Mode=TwoWay}" VerticalAlignment="Center"
                                  ToolTip="N'affiche que ce qui reste à faire (une option cochée reste visible)"/>
                    </DockPanel>
                </Border>

                <ListBox Grid.Row="2" ItemsSource="{Binding Source={StaticResource OptionsView}}" ItemContainerStyle="{StaticResource OptionItemStyle}"
                         ItemTemplate="{StaticResource OptionTemplate}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                         Padding="0,0,16,16">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Expander Style="{StaticResource GroupExpander}">
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>

                <local:InfoView Grid.Row="2" DataContext="{Binding Info}">
                    <local:InfoView.Style>
                        <Style TargetType="local:InfoView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:InfoView.Style>
                </local:InfoView>

                <TextBlock Grid.Row="2" Text="Aucune option à afficher." Foreground="{DynamicResource MutedBrush}" Margin="0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Visibles.Count}" Value="0"/>
                                        <Condition Binding="{Binding EstEmplacement}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Accueil -->
                <Border Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding EstAccueil, Converter={StaticResource BoolVis}}">
                    <local:AccueilView/>
                </Border>
                <!-- Diagnostic jeu -->
                <Border Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding EstDiagnostic, Converter={StaticResource BoolVis}}">
                    <local:DiagnosticView DataContext="{Binding Diagnostic}"/>
                </Border>
                <!-- Mode Jeu -->
                <Border Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding EstModeJeu, Converter={StaticResource BoolVis}}">
                    <local:ModeJeuView DataContext="{Binding ModeJeu}"/>
                </Border>

                <!-- Historique -->
                <Border Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding EstHistorique, Converter={StaticResource BoolVis}}">
                    <local:HistoriqueView DataContext="{Binding Historique}"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Barre du bas -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Profil" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" Width="200" Height="34" ItemsSource="{Binding ProfilsDisponibles}" SelectedItem="{Binding ProfilSelectionne, Mode=TwoWay}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <!-- Toutes les actions de profil dans un seul menu : la barre garde Aperçu et LANCER bien visibles. -->
                    <Button x:Name="BoutonProfil" Click="BoutonProfil_Click" ToolTip="Enregistrer, recharger, partager ou planifier le profil">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Profil"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource PoliceIcones}" FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MenuProfil" Placement="Top">
                                <MenuItem Header="Enregistrer la sélection sous…" Click="Sauver_Click"><MenuItem.Icon><TextBlock Text="&#xE74E;" FontFamily="{StaticResource PoliceIcones}" FontSize="14"/></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Recharger le profil" Click="Recharger_Click" ToolTip="Annule les cases changées depuis le chargement du profil"><MenuItem.Icon><TextBlock Text="&#xE72C;" FontFamily="{StaticResource PoliceIcones}" FontSize="14"/></MenuItem.Icon></MenuItem>
                                <Separator/>
                                <MenuItem Header="Exporter la sélection (pour un autre PC)…" Click="ExporterProfil_Click"><MenuItem.Icon><TextBlock Text="&#xEDE1;" FontFamily="{StaticResource PoliceIcones}" FontSize="14"/></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Importer un profil…" Click="ImporterProfil_Click"><MenuItem.Icon><TextBlock Text="&#xE8B5;" FontFamily="{StaticResource PoliceIcones}" FontSize="14"/></MenuItem.Icon></MenuItem>
                                <Separator/>
                                <MenuItem Header="Planifier une routine hebdomadaire…" Click="Planifier_Click" ToolTip="{Binding Routine.EtatTexte}"><MenuItem.Icon><TextBlock Text="&#xE787;" FontFamily="{StaticResource PoliceIcones}" FontSize="14"/></MenuItem.Icon></MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="4" Text="{Binding ResumeSelection}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="0,0,24,0"/>
                <Button Grid.Column="5" Content="Aperçu" IsEnabled="{Binding AUneSelection}" Click="Apercu_Click" Margin="0,0,12,0"/>
                <Button Grid.Column="6" Content="LANCER" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding AUneSelection}" Click="Lancer_Click"/>
            </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
