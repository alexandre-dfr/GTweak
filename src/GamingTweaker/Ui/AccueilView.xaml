<UserControl x:Class="GamingTweaker.Ui.AccueilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GamingTweaker.Ui">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="TitreSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="2,0,0,10"/>
        </Style>
        <Style x:Key="Secondaire" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Carte cliquable (style Paramètres de Windows 11) -->
        <Style x:Key="CarteBouton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource PanelHoverBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,16,24" MaxWidth="1080" HorizontalAlignment="Left">

            <!-- Synthèse -->
            <Border Style="{StaticResource CarteW11}" Padding="24,20" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding SyntheseAccueil}" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource PoliceTitre}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ResumePc}" Style="{StaticResource Secondaire}" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <!-- Barre d'information : Mode Jeu actif -->
            <Border Background="{DynamicResource WarnBg}" CornerRadius="6" Padding="16,10" Margin="0,0,0,8"
                    Visibility="{Binding ModeJeu.EstActif, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Ouvrir" Command="{Binding AllerCommand}" CommandParameter="Mode Jeu"/>
                    <TextBlock Text="Le Mode Jeu est actif : des services ou des processus sont arrêtés." VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- Démarrage rapide -->
            <TextBlock Text="Démarrage rapide" Style="{StaticResource TitreSection}" Margin="2,20,0,4"/>
            <TextBlock Text="Un clic coche les options du profil. Rien ne change avant « Aperçu » puis « LANCER »." Style="{StaticResource Secondaire}" Margin="2,0,0,12"/>
            <ItemsControl ItemsSource="{Binding ProfilsRapides}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CarteBouton}" Margin="0,0,10,0" ToolTip="{Binding Description}"
                                Command="{Binding DataContext.ProfilRapideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Nom}">
                            <DockPanel Margin="18,16">
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="Choisir" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding NombreTexte}" Style="{StaticResource Secondaire}"/>
                                </DockPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Nom}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Accroche}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Secondaire}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- État par menu : une ligne par menu, comme les Paramètres -->
                <StackPanel>
                    <TextBlock Text="État de ce PC" Style="{StaticResource TitreSection}"/>
                    <ItemsControl ItemsSource="{Binding EtatMenus}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CarteBouton}" Margin="0,0,0,4"
                                        Command="{Binding DataContext.AllerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Menu}">
                                    <Grid Margin="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Menu}"/>
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Proportion, Mode=OneWay}" Height="4" Margin="0,8,24,0"
                                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" BorderThickness="0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Texte}" Style="{StaticResource Secondaire}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,2"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Mode Jeu et raccourcis -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Mode Jeu" Style="{StaticResource TitreSection}"/>
                    <Border Style="{StaticResource CarteW11}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Secondaire}" FontSize="14" Margin="0,0,0,14"
                                       Text="Libère des ressources pendant la partie, avec un profil NVIDIA Performance ou Qualité, puis remet tout comme avant. Il peut s'activer tout seul au lancement d'un jeu."/>
                            <Button Content="Ouvrir le Mode Jeu" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Command="{Binding AllerCommand}" CommandParameter="Mode Jeu"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Raccourcis" Style="{StaticResource TitreSection}"/>
                    <Button Style="{StaticResource CarteBouton}" Margin="0,0,0,4" Command="{Binding AllerCommand}" CommandParameter="Historique">
                        <DockPanel Margin="16,12">
                            <TextBlock DockPanel.Dock="Right" Text="›" FontSize="18" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="Historique et annulation" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource CarteBouton}" Command="{Binding AllerCommand}" CommandParameter="Informations">
                        <DockPanel Margin="16,12">
                            <TextBlock DockPanel.Dock="Right" Text="›" FontSize="18" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="Informations du PC" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Bon à savoir -->
            <TextBlock Text="Bon à savoir" Style="{StaticResource TitreSection}" Margin="2,22,0,10"/>
            <Border Style="{StaticResource CarteW11}">
                <ItemsControl>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <TextBlock DockPanel.Dock="Left" Text="•" Foreground="{DynamicResource AccentBrush}" Width="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.Items>
                        <x:Static Member="local:AccueilView.Conseil1"/>
                        <x:Static Member="local:AccueilView.Conseil2"/>
                        <x:Static Member="local:AccueilView.Conseil3"/>
                        <x:Static Member="local:AccueilView.Conseil4"/>
                    </ItemsControl.Items>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
