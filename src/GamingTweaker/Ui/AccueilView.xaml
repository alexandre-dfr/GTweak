<UserControl x:Class="GamingTweaker.Ui.AccueilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GamingTweaker.Ui">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="Carte" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="22,18"/>
        </Style>
        <Style x:Key="TitreSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontFamily" Value="{StaticResource TitreFont}"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SousTitre" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Bouton « carte » : tout le bloc est cliquable, surbrillance au survol -->
        <Style x:Key="BoutonCarte" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AcidGradientBrush}"/>
                                <Setter TargetName="b" Property="Background" Value="{StaticResource PanelHoverBrush}"/>
                                <Setter TargetName="b" Property="Effect" Value="{StaticResource LueurAcide}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,16,20" MaxWidth="1100" HorizontalAlignment="Left">

            <!-- 1. Bandeau : ce PC en une ligne -->
            <Border Style="{StaticResource Carte}" Margin="0,0,0,18" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource AcidGradientBrush}" CornerRadius="3,0,0,3"/>
                    <StackPanel Grid.Column="1" Margin="22,18">
                        <TextBlock Text="{Binding SyntheseAccueil}" FontSize="24" FontFamily="{StaticResource TitreFont}" Foreground="{StaticResource ChromeBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ResumePc}" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="2" Margin="0,0,22,0" VerticalAlignment="Center" Padding="14,6" CornerRadius="2" Background="{StaticResource AccentBrush}" Effect="{StaticResource LueurAcide}"
                            Visibility="{Binding ModeJeu.EstActif, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="MODE JEU ACTIF" Foreground="{StaticResource AccentTextBrush}" FontFamily="{StaticResource TitreFont}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. Démarrage rapide : trois tuiles -->
            <TextBlock Text="Démarrage rapide" Style="{StaticResource TitreSection}"/>
            <TextBlock Text="Un clic coche les options du profil. Rien ne change sur le PC avant « Aperçu » puis « LANCER », en bas de la fenêtre." Style="{StaticResource SousTitre}"/>
            <ItemsControl ItemsSource="{Binding ProfilsRapides}" Margin="0,0,0,22">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource BoutonCarte}" Margin="0,0,14,0" ToolTip="{Binding Description}"
                                Command="{Binding DataContext.ProfilRapideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Nom}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="bande" Background="{StaticResource AccentBrush}" CornerRadius="3,3,0,0"/>
                                <StackPanel Grid.Row="1" Margin="18,16,18,18">
                                    <TextBlock x:Name="nom" Text="{Binding Nom}" FontSize="22" FontFamily="{StaticResource TitreFont}" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{Binding Accroche}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14"/>
                                    <DockPanel>
                                        <TextBlock Text="{Binding NombreTexte}" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="CHOISIR  ›" HorizontalAlignment="Right" FontFamily="{StaticResource TitreFont}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Rang}" Value="1">
                                <Setter TargetName="bande" Property="Background" Value="{StaticResource MagentaBrush}"/>
                                <Setter TargetName="nom" Property="Foreground" Value="{StaticResource MagentaBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Rang}" Value="2">
                                <Setter TargetName="bande" Property="Background" Value="{StaticResource CyanBrush}"/>
                                <Setter TargetName="nom" Property="Foreground" Value="{StaticResource CyanBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- 3. État de ce PC : une ligne par menu -->
                <Border Style="{StaticResource Carte}">
                    <StackPanel>
                        <TextBlock Text="État de ce PC" Style="{StaticResource TitreSection}"/>
                        <TextBlock Text="Réglages déjà en place, par menu. Cliquez sur une ligne pour l'ouvrir." Style="{StaticResource SousTitre}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding EtatMenus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BoutonCarte}" Margin="0,0,0,8"
                                            Command="{Binding DataContext.AllerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Menu}">
                                        <StackPanel Margin="14,10">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Texte}" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Menu}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Proportion, Mode=OneWay}" Height="6" Margin="0,8,0,0"
                                                         Foreground="{StaticResource AcidGradientBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 4. Mode Jeu et raccourcis -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Carte}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Mode Jeu" Style="{StaticResource TitreSection}"/>
                            <TextBlock Style="{StaticResource SousTitre}" Margin="0,0,0,14"
                                       Text="Libère des ressources pendant la partie (profil NVIDIA Performance ou Qualité inclus), puis remet tout comme avant. Il peut s'activer tout seul au lancement d'un jeu."/>
                            <Button Content="Ouvrir le Mode Jeu" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Command="{Binding AllerCommand}" CommandParameter="Mode Jeu"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Carte}">
                        <StackPanel>
                            <TextBlock Text="Raccourcis" Style="{StaticResource TitreSection}" Margin="0,0,0,12"/>
                            <Button Content="Historique et annulation" Command="{Binding AllerCommand}" CommandParameter="Historique" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                            <Button Content="Informations du PC" Command="{Binding AllerCommand}" CommandParameter="Informations" HorizontalContentAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 5. Bon à savoir -->
            <Border Style="{StaticResource Carte}">
                <StackPanel>
                    <TextBlock Text="Bon à savoir" Style="{StaticResource TitreSection}" Margin="0,0,0,12"/>
                    <ItemsControl>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Left" Text="▸" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Width="22" FontSize="15"/>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="14"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.Items>
                            <x:Static Member="local:AccueilView.Conseil1"/>
                            <x:Static Member="local:AccueilView.Conseil2"/>
                            <x:Static Member="local:AccueilView.Conseil3"/>
                            <x:Static Member="local:AccueilView.Conseil4"/>
                        </ItemsControl.Items>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
