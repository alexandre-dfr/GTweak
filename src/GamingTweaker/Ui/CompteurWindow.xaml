<Window x:Class="GamingTweaker.Ui.CompteurWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compteur GamingTweaker" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Focusable="False" IsHitTestVisible="False">
    <!-- Surimpression en jeu : transparente aux clics (styles étendus posés dans le code), jamais activée, absente de la barre des tâches et d'Alt+Tab. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>
    <Border Background="{Binding BrosseFond}" CornerRadius="6" Padding="10,6,10,7">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Echelle}" ScaleY="{Binding Echelle}"/>
        </Border.LayoutTransform>
        <StackPanel TextElement.Foreground="{Binding BrosseTexte}" TextElement.FontFamily="Consolas" TextElement.FontSize="13">
            <StackPanel Visibility="{Binding Fps, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FPS" Opacity="0.75" VerticalAlignment="Bottom" Margin="0,0,6,3"/>
                    <TextBlock Text="{Binding TexteFps}" FontSize="22" FontWeight="Bold" MinWidth="44"/>
                    <TextBlock Text="{Binding TexteDetails}" VerticalAlignment="Bottom" Margin="10,0,0,3" Visibility="{Binding Details, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <TextBlock Text="{Binding TexteProcessus}" FontSize="10" Opacity="0.6" Margin="0,0,0,2"/>
            </StackPanel>
            <Grid Width="200" Height="36" Margin="0,2,0,4" Visibility="{Binding AfficherCourbe, Converter={StaticResource BoolVis}}">
                <Border BorderBrush="{Binding BrosseTexte}" BorderThickness="0,0,0,1" Opacity="0.35"/>
                <Polyline Points="{Binding PointsCourbe}" Stroke="{Binding BrosseTexte}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Visibility="{Binding AfficherCharge, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding TexteCpu}" Margin="0,0,12,0" Visibility="{Binding Cpu, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding TexteGpu}" Margin="0,0,12,0" Visibility="{Binding Gpu, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding TexteRam}" Visibility="{Binding Ram, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
