<Window x:Class="GamingTweaker.Ui.CompteurWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compteur GamingTweaker" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight">
    <!-- Surimpression en jeu : transparente aux clics hors placement (styles étendus posés dans le code), jamais activée, absente de la barre des tâches et d'Alt+Tab.
         Largeur fixe et police à chasse fixe : rien ne bouge quand les chiffres changent. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>
    <Grid>
        <Border x:Name="Cadre" Background="{Binding BrosseFond}" CornerRadius="6" Padding="10,6,10,7" Width="260">
            <Border.LayoutTransform>
                <ScaleTransform ScaleX="{Binding Echelle}" ScaleY="{Binding Echelle}"/>
            </Border.LayoutTransform>
            <StackPanel TextElement.Foreground="{Binding BrosseTexte}" TextElement.FontFamily="Consolas" TextElement.FontSize="13">
                <TextBlock x:Name="Consigne" Text="Glissez pour déplacer · coin ◢ ou Ctrl+molette pour la taille" FontFamily="Segoe UI" FontSize="11" Foreground="White" Opacity="0.85" TextWrapping="Wrap"
                           Margin="0,0,0,4" Visibility="{Binding ModePlacement, Converter={StaticResource BoolVis}}"/>
                <StackPanel Visibility="{Binding Fps, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="FPS" Opacity="0.75" VerticalAlignment="Bottom" Margin="0,0,6,3" Foreground="{Binding BrosseFps}"/>
                        <TextBlock Text="{Binding TexteFps}" FontSize="22" FontWeight="Bold" Width="50" TextAlignment="Right" Foreground="{Binding BrosseFps}"/>
                        <TextBlock Text="{Binding TexteDetails}" VerticalAlignment="Bottom" Margin="8,0,0,3" Foreground="{Binding BrosseDetails}" Visibility="{Binding Details, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TexteProcessus}" FontSize="10" Opacity="0.6" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Grid Width="200" Height="36" Margin="0,2,0,4" HorizontalAlignment="Left" Visibility="{Binding AfficherCourbe, Converter={StaticResource BoolVis}}">
                    <Border BorderBrush="{Binding BrosseCourbe}" BorderThickness="0,0,0,1" Opacity="0.35"/>
                    <Polyline Points="{Binding PointsCourbe}" Stroke="{Binding BrosseCourbe}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                </Grid>
                <StackPanel Visibility="{Binding AfficherCharge, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding TexteCpu}" Foreground="{Binding BrosseCpu}" Visibility="{Binding Cpu, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding TexteGpu}" Foreground="{Binding BrosseGpu}" Visibility="{Binding Gpu, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding TexteRam}" Foreground="{Binding BrosseRam}" Visibility="{Binding Ram, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- Cadre pointillé du mode placement, et poignée de redimensionnement dans le coin bas-droit -->
        <Rectangle IsHitTestVisible="False" RadiusX="6" RadiusY="6" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="3 2"
                   Visibility="{Binding ModePlacement, Converter={StaticResource BoolVis}}"/>
        <Thumb x:Name="Poignee" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
               ToolTip="Glissez pour agrandir ou réduire le compteur" Visibility="{Binding ModePlacement, Converter={StaticResource BoolVis}}">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 16,3 L 16,16 L 3,16 Z" Fill="{DynamicResource AccentBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
