<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Couleurs du thème clair (Windows 11). Les vues les lisent en DynamicResource : le thème change sans redémarrer. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FBFBFB"/>
    <SolidColorBrush x:Key="BgBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FBFBFB"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="DiscretBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A6FC2"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#FDFDFD"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#EDEDED"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#FCFCFC"/>
    <SolidColorBrush x:Key="SurBg" Color="#DFF6DD"/>
    <SolidColorBrush x:Key="SurFg" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="AvanceBg" Color="#FFF4CE"/>
    <SolidColorBrush x:Key="AvanceFg" Color="#8A5300"/>
    <SolidColorBrush x:Key="RisqueBg" Color="#FDE7E9"/>
    <SolidColorBrush x:Key="RisqueFg" Color="#C42B1C"/>
    <SolidColorBrush x:Key="WarnBg" Color="#FFF4CE"/>
</ResourceDictionary>
