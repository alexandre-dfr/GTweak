<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GamingTweaker</RootNamespace>
    <AssemblyName>GamingTweaker</AssemblyName>
    <Nullable>disable</Nullable>
    <StartupObject>GamingTweaker.Program</StartupObject>
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>
    <!-- Version visible dans les propriétés de l'exe et en tête de chaque report.txt (support). -->
    <Version>0.9.1</Version>
    <AssemblyVersion>0.9.1.0</AssemblyVersion>
    <FileVersion>0.9.1.0</FileVersion>
    <Product>GamingTweaker</Product>
    <Company>GamingTweaker</Company>
    <Copyright>Licence GNU AGPL-3.0</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <!-- Icône de l'exe et, par défaut, de la fenêtre WPF (générée par tools/icone.py). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Un seul fichier à distribuer : pas de GamingTweaker.exe.config. Il ne contenait que <supportedRuntime> (inutile : .NET Framework 4.8
         est intégré à Windows 10 1903+ et 11) ; les DLL embarquées sont résolues par nom (AssemblyLoader), sans redirection de liaison. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!-- Numéro de build de la CI (variable d'environnement GT_BUILD = numéro du run GitHub Actions) : chaque exe publié a sa propre version
       (0.9.1.58), affichée dans l'application et dans les rapports. En local, la révision reste 0. -->
  <PropertyGroup Condition="'$(GT_BUILD)' != ''">
    <AssemblyVersion>$(Version).$(GT_BUILD)</AssemblyVersion>
    <FileVersion>$(Version).$(GT_BUILD)</FileVersion>
  </PropertyGroup>

  <!-- requireAdministrator en Release, asInvoker en Debug (voir global-constraints). Release : aucun symbole livré. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <ApplicationManifest>app.debug.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\catalog\*.json" LogicalName="catalog/%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="Assets\bloatware-list.json" LogicalName="bloatware-list.json" WithCulture="false" />
    <EmbeddedResource Include="Assets\scripts\*.ps1" LogicalName="scripts/%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="Assets\runtime\*.ps1" LogicalName="runtime/%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GamingTweaker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceProcess" />
    <!-- Icône de la zone de notification (NotifyIcon) : aucune autre partie de l'interface n'utilise Windows Forms. -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- Integre chaque DLL copiee localement en ressource embarquee et empeche sa copie. -->
  <Target Name="EmbedLocalDlls" AfterTargets="ResolveReferences">
    <ItemGroup>
      <_DllToEmbed Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll' And !$([System.String]::Copy('%(Filename)').EndsWith('.resources'))" />
      <EmbeddedResource Include="@(_DllToEmbed)" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
      <!-- On retire DLL, satellites, pdb et xml des fichiers copies a cote de l'exe. -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll' Or '%(Extension)' == '.pdb' Or '%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>

</Project>
