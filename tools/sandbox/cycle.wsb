<Configuration>
  <!-- Chemins absolus : adapter si le dépôt est ailleurs. L'exe est mappé en lecture seule, les résultats en écriture. -->
  <VGpu>Disable</VGpu>
  <Networking>Enable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Users\adu\Downloads\TEMP\src\GamingTweaker\bin\Release\net48</HostFolder>
      <SandboxFolder>C:\GT\exe</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Users\adu\Downloads\TEMP\tools\sandbox</HostFolder>
      <SandboxFolder>C:\GT\outils</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Users\adu\Downloads\TEMP\tools\sandbox\resultats</HostFolder>
      <SandboxFolder>C:\GT\resultats</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\GT\outils\start-cycle.ps1</Command>
  </LogonCommand>
</Configuration>
